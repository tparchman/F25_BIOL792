sem0 <- psem(
lm(gen_s ~ env_s + geo_s, data = semdata),
lm(env_s ~ geo_s, data = semdata)
)
summary(sem0)
### IBD / IBE
sem1 <- psem(
lmer(gen_s ~ env_s + geo_s + (1|pop1) + (1|pop2), data = semdata),
lmer(env_s ~ geo_s + (1|pop1) + (1|pop2), data = semdata)
)
summary(sem1)
### IBD / IBE
sem11 <- psem(
lmer(gen_s ~ env_s + geo_s + (1|pop1) + (1|pop2), data = semdata),
lm(env_s ~ geo_s, data = semdata)
)
summary(sem11)
# create random effect #
npop <- nrow(as.matrix(g_dist))
n <- (npop*(npop-1))/2
pop1<-numeric(n)
pop2<-numeric(n)
k<-1
for(i in 1:(npop-1)){
for(j in (i+1):npop){
pop1[k]<-i
pop2[k]<-j
k<-k+1
}
}
gen_list <- as.vector(as.dist(g_dist))
geo_list <- as.vector(as.dist(geo_dist))
env_list <- as.vector(as.dist(env_dist))
chem_list <- as.vector(as.dist(chem_dist))
semdata <- data.frame(
gen_s = scale(gen_list),
geo_s = scale(geo_list),
env_s = scale(env_list),
chem_s = scale(chem_list),
gen = gen_list,
geo = geo_list,
env = env_list,
pop1 = pop1,
pop2 = pop2
)
summary(lmer(gen_s ~ env_s + geo_s, data = semdata))
summary(lm(gen_s ~ env_s + geo_s, data = semdata))
summary(lm(env_s ~ geo_s, data = semdata))
summary(lmer(gen_s ~ env_s + geo_s + (1|pop1) + (1|pop2), data = semdata))
summary(lmer(env_s ~ geo_s + (1|pop1) + (1|pop2), data = semdata))
summary(lmer(chem_s ~ gen_s + env_s + geo_s + (1|pop1) + (1|pop2), data = semdata))
summary(lmer(env_s ~ geo_s, data = semdata))
summary(lm(env_s ~ geo_s, data = semdata))
