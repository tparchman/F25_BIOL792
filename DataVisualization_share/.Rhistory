library(umap)
library(hierfstat)
source('~/Desktop/src/R/Imports.R')
res <- read_table('angsd/relatedness_milkweed.res')
res_all <- data.frame(index=0:(nrow(Pop_ID_Sum)-1),All=Pop_ID_Sum$All)
#### MAKE POP ID FILE ####
indv <- read.table("../raw_files/good_snps.recode.vcf.012.indv",sep="\t")
Pop <- rep(NA,times=nrow(indv))
ID <- rep(NA,times=nrow(indv))
All <- rep(NA,times=nrow(indv))
for (i in 1:nrow(indv)){
fq <- unlist(strsplit(as.character(indv$V1[i]),"/"))[7]
name <- unlist(strsplit(as.character(fq),".fastq.gz_sorted.bam"))[1]
Pop[i] <- unlist(strsplit(as.character(name),"_"))[2]
ID[i] <- unlist(strsplit(as.character(name),"_"))[3]
All[i] <- as.character(name)
}
Pop_ID <- data.frame(Pop,ID,All)
write.csv(Pop_ID,'Pop_ID.csv',row.names = F)
#### Make Pop_ID_Sum file ####
Pop_Sum <- read.csv('Pop_Sum.csv')
Pop_ID <- read.csv('Pop_ID.csv')
Pop_ID_Sum <- left_join(Pop_ID,Pop_Sum)
write.csv(Pop_ID_Sum,'Pop_ID_Sum.csv',row.names = F)
#### Make Pop_Sum in right order ####
Pop_Sum <- unique(Pop_ID_Sum[,c(1,4,5,6,7)])
write.csv(Pop_Sum,'Pop_Sum.csv',row.names = F)
res <- read_table('angsd/relatedness_milkweed.res')
res_all <- data.frame(index=0:(nrow(Pop_ID_Sum)-1),All=Pop_ID_Sum$All)
rel_df <- res[c('a','b','rab')]
rel_df$All1 <- NA
rel_df$All2 <- NA
for (i in 1:nrow(rel_df)){
rel_df$All1[i] <- as.character(res_all$All[which(res_all$index== rel_df$a[i])])
rel_df$All2[i] <- as.character(res_all$All[which(res_all$index== rel_df$b[i])])
}
#hist(rel_df$rab)
#summary(rel_df$rab)
#sort(rel_df$rab,decreasing = TRUE)[1:500] #0.886207
clone_df <- rel_df[which(rel_df$rab > 0.75),]
length(unique(c(clone_df$All1,clone_df$All2)))
write.csv(clone_df,'angsd/clone_df.csv')
clone_count_df <- data.frame(All=unique(c(clone_df$All1,clone_df$All2)))
clone_count_df <- left_join(clone_count_df,Pop_ID_Sum)
Pop_count <- Pop_ID_Sum %>%
group_by(Pop) %>%
summarize(total=n())
Pop_clone <- clone_count_df %>%
group_by(Pop) %>%
summarize(clone=n())
Pop_clone_df <- left_join(Pop_count,Pop_clone)
Pop_clone_df$clone[which(is.na(Pop_clone_df$clone))] <- 0
Pop_clone_df$clone_perc <- Pop_clone_df$clone/Pop_clone_df$total
write.csv(Pop_clone_df,'angsd/Pop_clone_df.csv')
write.csv(Pop_clone_df,'angsd/Pop_clone_df.csv',row.names = F)
