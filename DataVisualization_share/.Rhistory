invasive.sum
#Create interaction plot
library(ggsci)
library(ggplot2)
invas_plot_dodge.2 <- ggplot(data=invasive.sum,aes(x=as.character(year), y=mean,
fill=treatment,color=treatment,group=treatment)) +
geom_line(size = 1,linetype='solid', position = position_dodge(.1),show.legend=FALSE) +
geom_point(aes(shape=treatment,size=3), position=position_dodge(.1)) +
#guides(<scale> = "none")+
scale_shape_manual(name="Treatment:",values=c(15,4,16,17))+
geom_errorbar(aes(ymin = mean - ci, ymax = mean + ci),width=0.3,
position = position_dodge(.1)) + #added error bars  scale_x_discrete(expand = c(0.1,0.1)) + #i changed this
scale_fill_npg(name='Treatment:') +
scale_color_npg(name='Treatment:') +
theme_bw() + ylab("Number on the non-native species per m^2") +
theme(title = element_text(size = 13, colour="black",face = "bold"),
axis.text = element_text(size=16),
axis.text.x = element_text(size = 16, colour="black",face = "bold"),
axis.title = element_text(size = 20, colour="black",face = "bold"),
axis.title.x = element_blank(),
#legend.position="none",
panel.border = element_rect(size = 1.5, colour = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.title = element_text(size = 16, face = "bold"),
legend.text = element_text(size=15))
