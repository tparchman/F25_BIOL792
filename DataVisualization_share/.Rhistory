setwd('~/g/People/Laura/fig_help/')
data<-read.csv("Field_data.csv")
library(tidyverse)
library(car)
l.data <- data
l.data[,6:56] <- data [,6:56]+0.5
write.csv(l.data,"data_with_addition.csv", row.names = FALSE)
#### Non-native species --------------------- log ####
#create group of invasive species
data$invasivesum=data$b_tectorum+data$a_desetorum+data$c_testiculata+data$d_sophia+data$e_cicutarium+data$l_seriola+data$t_dubius
#create group of invasive species with 0.5 added for log transformation
l.data$invasivesum.log=l.data$b_tectorum+l.data$a_desetorum+l.data$c_testiculata+l.data$d_sophia+l.data$e_cicutarium+l.data$l_seriola+l.data$t_dubius
#untransformed model NOT NORMAL
invasive.model<-glm(invasivesum ~ treatment*year, data = data, family = poisson(link="log"))
summary(invasive.model)
Anova(invasive.model)
qqnorm(resid(invasive.model))
qqline(resid(invasive.model))
hist(resid(invasive.model))
#log model - IMRPROVED
invasive.model.log<-lm(log(invasivesum.log) ~ treatment*year, data = l.data)
summary(invasive.model.log)
Anova(invasive.model.log)
qqnorm(resid(invasive.model.log))
qqline(resid(invasive.model.log))
hist(resid(invasive.model.log))
##get summary statistics
invasive.sum <- data  %>%
group_by(treatment,year) %>%
summarise(mean = mean(invasivesum, na.rm = TRUE),
sd = sd(invasivesum, na.rm = TRUE),
n = sum(!is.na(invasivesum))) %>%
mutate(se = sd / sqrt(n),
ci = 1.96 * se)
invasive.sum
#for loop for percent change in mean for each group
for (x in seq(1,nrow(invasive.sum),2)) {
n = ((invasive.sum[x+1,"mean"] - invasive.sum[x,"mean"]) / invasive.sum[x,"mean"])* 100
n = round(n)
print(n)
}
